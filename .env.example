# ============================================================
# SpeakLingo .env.example — copy to .env and fill in real values
# ============================================================

# === Primary Database (Supabase Postgres via Supavisor pooler) ===
# Format: postgresql://postgres.[REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.XXXXXX:YOUR_PASSWORD@aws-0-XX-XXXX-X.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# === Direct connection (for migrations, port 5432) ===
DIRECT_URL="postgresql://postgres.XXXXXX:YOUR_PASSWORD@aws-0-XX-XXXX-X.pooler.supabase.com:5432/postgres"

# === Supabase client (browser-side, safe to expose) ===
NEXT_PUBLIC_SUPABASE_URL="https://XXXXXX.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XXXXXXX"

# === Supabase server-side (NEVER expose to browser) ===
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXX"

# ============================================================
# Z-AI SDK (for LLM, TTS, ASR — required in production)
# ------------------------------------------------------------
# These values come from your local /etc/.z-ai-config file.
# To find them, run: cat /etc/.z-ai-config
# Then copy each value to Vercel Environment Variables.
# ============================================================
ZAI_API_KEY="Z.ai"
ZAI_BASE_URL="https://internal-api.z.ai/v1"
ZAI_TOKEN="eyJhbGc...your-jwt-token..."
ZAI_USER_ID="your-user-id-here"
ZAI_CHAT_ID="your-chat-id-here"
