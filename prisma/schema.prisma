// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String    @id @default(cuid())
  language  String    @default("english")
  level     String    @default("beginner")
  topic     String    @default("daily-life")
  title     String    @default("Untitled Session")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  mistakes  Mistake[]
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant"
  content    String
  audioPath  String?
  createdAt  DateTime @default(now())
}

model Mistake {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  original     String
  corrected    String
  type         String
  explanation  String
  createdAt    DateTime @default(now())
}

// Saved lessons (free-form, generated by tuition teacher mode)
model Lesson {
  id         String   @id @default(cuid())
  language   String
  level      String
  topic      String
  title      String
  content    String
  createdAt  DateTime @default(now())
}

// Saved vocabulary / phrases the learner has starred
model LearnedItem {
  id         String   @id @default(cuid())
  language   String
  type       String   // "word" | "phrase"
  item       String
  meaning    String
  example    String?
  starred    Boolean  @default(true)
  createdAt  DateTime @default(now())
  reviews    Review[]
}

// Spaced-repetition review cards (one per LearnedItem)
// Implements a simplified SM-2 algorithm.
model Review {
  id            String   @id @default(cuid())
  learnedItemId String
  learnedItem   LearnedItem @relation(fields: [learnedItemId], references: [id], onDelete: Cascade)
  language      String
  // SM-2 fields
  ease          Float    @default(2.5)  // ease factor (1.3 .. 3.0)
  interval      Int      @default(0)    // days until next review
  repetitions   Int      @default(0)    // consecutive correct
  dueAt         DateTime @default(now())
  lastReviewed  DateTime?
  createdAt     DateTime @default(now())
}

// Curriculum progress: which lesson node the learner has completed.
// nodeId matches the id in the static curriculum data file.
model Progress {
  id           String   @id @default(cuid())
  language     String
  nodeId       String
  status       String   @default("locked") // "locked" | "available" | "in-progress" | "completed"
  score        Int?     // quiz score 0-100
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt
  @@unique([language, nodeId])
}

// Daily streak tracking
model Streak {
  id              String   @id @default(cuid())
  language        String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String   // YYYY-MM-DD
  totalActiveDays Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// Achievement badges earned by the learner
model Achievement {
  id        String   @id @default(cuid())
  code      String   // e.g. "first-lesson", "7-day-streak"
  language  String?
  earnedAt  DateTime @default(now())
  @@unique([code, language])
}

// Pronunciation attempts (record + score)
model PronunciationAttempt {
  id           String   @id @default(cuid())
  language     String
  targetText   String
  transcribed  String
  score        Int      // 0-100
  phonemeNotes String?  // JSON of per-word feedback
  createdAt    DateTime @default(now())
}
