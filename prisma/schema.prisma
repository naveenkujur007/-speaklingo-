// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id        String    @id @default(cuid())
  language  String    @default("english")
  level     String    @default("beginner")
  topic     String    @default("daily-life")
  title     String    @default("Untitled Session")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  mistakes  Mistake[]
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant"
  content    String
  audioPath  String?
  createdAt  DateTime @default(now())
}

model Mistake {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  original     String
  corrected    String
  type         String   // "grammar" | "spelling" | "vocabulary" | "pronunciation" | "word-order"
  explanation  String
  createdAt    DateTime @default(now())
}

// Saved lessons generated by the Tuition Teacher mode.
model Lesson {
  id         String   @id @default(cuid())
  language   String
  level      String
  topic      String
  title      String
  content    String   // full JSON of the lesson payload
  createdAt  DateTime @default(now())
}

// Vocabulary / phrases the learner has marked as "learned" or "starred".
model LearnedItem {
  id         String   @id @default(cuid())
  language   String
  type       String   // "word" | "phrase"
  item       String   // the word/phrase in target language
  meaning    String   // meaning in hint language
  example    String?
  starred    Boolean  @default(true)
  createdAt  DateTime @default(now())
}
