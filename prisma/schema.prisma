// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id        String    @id @default(cuid())
  language  String    @default("english")
  level     String    @default("beginner")
  topic     String    @default("daily-life")
  title     String    @default("Untitled Session")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  mistakes  Mistake[]
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String
  audioPath  String?
  createdAt  DateTime @default(now())
}

model Mistake {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  original     String
  corrected    String
  type         String
  explanation  String
  createdAt    DateTime @default(now())
}

model Lesson {
  id         String   @id @default(cuid())
  language   String
  level      String
  topic      String
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model LearnedItem {
  id         String   @id @default(cuid())
  language   String
  type       String
  item       String
  meaning    String
  example    String?
  starred    Boolean  @default(true)
  createdAt  DateTime @default(now())
  reviews    Review[]
}

model Review {
  id            String   @id @default(cuid())
  learnedItemId String
  learnedItem   LearnedItem @relation(fields: [learnedItemId], references: [id], onDelete: Cascade)
  language      String
  ease          Float    @default(2.5)
  interval      Int      @default(0)
  repetitions   Int      @default(0)
  dueAt         DateTime @default(now())
  lastReviewed  DateTime?
  createdAt     DateTime @default(now())
}

model Progress {
  id           String   @id @default(cuid())
  language     String
  nodeId       String
  status       String   @default("locked")
  score        Int?
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt
  @@unique([language, nodeId])
}

model Streak {
  id              String   @id @default(cuid())
  language        String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String
  totalActiveDays Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Achievement {
  id        String   @id @default(cuid())
  code      String
  language  String?
  earnedAt  DateTime @default(now())
  @@unique([code, language])
}

model PronunciationAttempt {
  id           String   @id @default(cuid())
  language     String
  targetText   String
  transcribed  String
  score        Int
  phonemeNotes String?
  createdAt    DateTime @default(now())
}
